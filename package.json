{
  "name": "dsh-switcher",
  "version": "0.1.9",
  "private": true,
  "description": "DSH Switcher — Ctrl+Tab 最近会话切换器",
  "type": "module",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test:install": "node scripts/verify-git-install.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:local": "npm run build && npm pack --ignore-scripts --pack-destination dist"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-api-workspace-controller", "@deepseek-ai/dsh-client-ui-theme"]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iobee/dsh-switcher.git"
  }
}
